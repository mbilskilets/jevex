{
  "name": "@mbilskilets/jevex",
  "version": "0.1.0",
  "description": "A small Convex component that uses Jev to build a semantic index over your tables.",
  "type": "module",
  "main": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts",
      "default": "./dist/component/_generated/component.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    }
  },
  "files": [
    "dist",
    "convex.config.ts"
  ],
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "convex codegen --component-dir ./src/component && bun run build && convex codegen",
    "build:clean": "rm -rf dist *.tsbuildinfo && bun run build:codegen",
    "dev": "convex dev --typecheck-components",
    "link": "bun link && cd example && bun install",
    "typecheck": "tsc --noEmit --project ./tsconfig.test.json && cd example && tsc --noEmit",
    "test": "bun run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "convex",
    "component",
    "typesafe",
    "jev",
    "ai",
    "classification",
    "semantic-index",
    "triage"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbilskilets/jevex.git"
  },
  "homepage": "https://github.com/mbilskilets/jevex#readme",
  "bugs": {
    "url": "https://github.com/mbilskilets/jevex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@convex-dev/workpool": "^0.4.12",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@convex-dev/rate-limiter": "^0.4.0",
    "@edge-runtime/vm": "^5.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.124",
    "convex-test": "^0.0.59",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
